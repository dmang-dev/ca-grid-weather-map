# Python
.venv/
__pycache__/
*.pyc
*.pyo

# Fetched data is NOT committed. deploy-pages.yml regenerates it straight into
# the Pages artifact, so the hosted demo stays fresh without 15 MB geojson
# blobs landing in git history every two hours. Run `python fetch_data.py` to
# populate data/ locally. The directory's README stays tracked.
data/*
!data/README.md

# Logs and scratch
*.log
.rstk/
.claude/
probe_endpoints.py

# OS
.DS_Store
Thumbs.db
desktop.ini

# Editors
.idea/
.vscode/
*.swp
